<Project Sdk="Microsoft.NET.Sdk">

	<!--
		테스트 하네스 제어 프로토콜(테스트 전용). Protos/harness.proto는 TestHarness 빌드가 복사해 넣는
		사본이다 - 원본은 GameProject1/TestHarness/Protos/harness.proto. 여기서 고치지 말 것.
		서버와 Unity는 하네스에 "접속하는 쪽"이라 클라이언트 스텁만 만든다.
	-->

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.Tools" Version="2.63.0" PrivateAssets="All" />
		<PackageReference Include="Google.Protobuf" Version="3.27.2" />
		<PackageReference Include="Grpc.Core.Api" Version="2.63.0" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\harness.proto" GrpcServices="Client" />
	</ItemGroup>

	<!-- 다른 Contracts와 같은 방식으로 Unity에 생성 코드를 넘긴다. 위치만 테스트 폴더. -->
	<PropertyGroup>
		<UnityHarnessGeneratedPath>$(UnityProjectPath)\Assets\Scripts\Test\Harness\Generated</UnityHarnessGeneratedPath>
	</PropertyGroup>
	<Target Name="CopyGeneratedToUnity" AfterTargets="Build">
		<Copy
		  SourceFiles="$(ProjectDir)obj\$(Configuration)\$(TargetFramework)\Protos\Harness.cs;
                   $(ProjectDir)obj\$(Configuration)\$(TargetFramework)\Protos\HarnessGrpc.cs"
		  DestinationFolder="$(UnityHarnessGeneratedPath)" />
	</Target>

</Project>
