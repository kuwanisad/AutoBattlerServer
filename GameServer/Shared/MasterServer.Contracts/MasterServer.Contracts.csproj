<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.Tools" Version="2.63.0" PrivateAssets="All" />
		<PackageReference Include="Google.Protobuf" Version="3.27.0" />
		<PackageReference Include="Grpc.Core.Api" Version="2.63.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Common.Contracts\Common.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Both: 서버용 베이스 클래스(MasterControlBase)와 클라이언트용 클래스(MasterControlClient)를
         이 프로젝트 하나에서 같이 생성한다. MasterServer는 Base를, LobbyServer는 Client를 쓴다. -->
		<Protobuf Include="Protos\master.proto" GrpcServices="Both">
			<AdditionalImportDirs>..\Common.Contracts\Protos</AdditionalImportDirs>
		</Protobuf>
	</ItemGroup>

	<!-- 원래는 없었음 - 유니티가 지금까지 마스터 프로토콜을 직접 참조할 일이 없었으나
	     (항상 로비/게임 에이전트를 거쳐서만 간접적으로 관련됨), ingame.proto/
	     ingame_server_dispatch.proto가 AnnouncementTask(마스터가 정의한 타입)를 직접
	     참조하게 되면서 처음으로 필요해짐. -->
	<Target Name="CopyGeneratedToUnity" AfterTargets="Build">
		<Copy
		  SourceFiles="$(ProjectDir)obj\$(Configuration)\$(TargetFramework)\Protos\Master.cs;
                   $(ProjectDir)obj\$(Configuration)\$(TargetFramework)\Protos\MasterGrpc.cs"
		  DestinationFolder="$(UnityServerGeneratedPath)" />
	</Target>

</Project>