<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Google.Protobuf" Version="3.27.2" />
		<PackageReference Include="Grpc.Tools" Version="2.63.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LobbyServer.Contracts\LobbyServer.Contracts.csproj" />
		<ProjectReference Include="..\ChatServer.Contracts\ChatServer.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\client_dispatch.proto" GrpcServices="None">
			<AdditionalImportDirs>..\LobbyServer.Contracts\Protos;..\Common.Contracts\Protos;..\ChatServer.Contracts\Protos</AdditionalImportDirs>
		</Protobuf>
	</ItemGroup>

	<Target Name="CopyGeneratedToUnity" AfterTargets="Build">
		<Copy
		  SourceFiles="$(ProjectDir)obj\$(Configuration)\$(TargetFramework)\Protos\ClientDispatch.cs"
		  DestinationFolder="$(UnityClientGeneratedPath)" />
	</Target>

</Project>
